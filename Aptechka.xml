<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
    <Button name="NugRaidUnitButtonTemplate" virtual="true" inherits="SecureUnitButtonTemplate" registerForClicks="AnyUp">
        <Size x="50" y="50"/>
        <Frames>
            <AuraContainer parentKey="DebuffContainer" frameLevel="5" inherits="CustomAuraContainerTemplate">
                <Anchors>
                    <Anchor point="BOTTOMLEFT" relativeTo="$parent" relativePoint="BOTTOMLEFT" x="0" y="0"/>
                    <Anchor point="TOPRIGHT" relativeTo="$parent" relativePoint="TOPRIGHT" x="0" y="0"/>
                </Anchors>
            </AuraContainer>
            <AuraContainer parentKey="BuffContainer" inherits="CustomAuraContainerTemplate">
                <Anchors>
                    <Anchor point="BOTTOMLEFT" relativeTo="$parent" relativePoint="BOTTOMLEFT" x="0" y="0"/>
                    <Anchor point="TOPRIGHT" relativeTo="$parent" relativePoint="TOPRIGHT" x="0" y="0"/>
                </Anchors>
            </AuraContainer>
            <Frame parentKey="pingIconFrame" frameLevel="5" inherits="UnitPingIconFrameTemplate">
				<KeyValues>
					<KeyValue key="isRaidFrame" value="true" type="boolean"/>
				</KeyValues>
				<Anchors>
					<Anchor point="CENTER"/>
				</Anchors>
			</Frame>
        </Frames>
    </Button>
</Ui>