<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
    <Button name="NugRaidUnitButtonTemplate" virtual="true" inherits="SecureUnitButtonTemplate">
        <Size x="50" y="50"/>
        <Frames>
            <AuraContainer parentKey="DebuffContainer" inherits="CustomAuraContainerTemplate">
                <Anchors>
                    <Anchor point="BOTTOMLEFT" relativeTo="$parent" relativePoint="BOTTOMLEFT" x="0" y="0"/>
                    <Anchor point="TOPRIGHT" relativeTo="$parent" relativePoint="TOPRIGHT" x="0" y="0"/>
                </Anchors>
            </AuraContainer>
            <AuraContainer parentKey="BuffContainer" inherits="CustomAuraContainerTemplate">
                <Anchors>
                    <Anchor point="BOTTOMLEFT" relativeTo="$parent" relativePoint="BOTTOMLEFT" x="0" y="0"/>
                    <Anchor point="TOPRIGHT" relativeTo="$parent" relativePoint="TOPRIGHT" x="0" y="0"/>
                </Anchors>
            </AuraContainer>
        </Frames>
    </Button>
</Ui>